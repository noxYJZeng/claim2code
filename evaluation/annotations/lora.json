  "claims": [
    {
      "claim_id": "lora_c1",
      "text": "LoRA injects trainable low-rank decomposition matrices A and B alongside each frozen pretrained weight matrix.",
      "evidence_span": {"section": "1", "page": 2, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "loralib/layers.py", "name": "LoRALayer", "kind": "class"},
        {"file_path": "loralib/layers.py", "name": "Linear", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "lora_c2",
      "text": "The forward pass computes h = W_0 x + (B A) x scaled by alpha / r.",
      "evidence_span": {"section": "1", "page": 2, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "loralib/layers.py", "name": "Linear", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "lora_c3",
      "text": "Matrix A is initialized with a Gaussian and matrix B is initialized to zero so the initial forward pass equals the pretrained model.",
      "evidence_span": {"section": "4.1", "page": 5, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "loralib/layers.py", "name": "LoRALayer", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "lora_c4",
      "text": "The merged weight matrix can be recomputed at inference by folding B A back into W_0 so no extra latency is incurred.",
      "evidence_span": {"section": "1", "page": 3, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "loralib/layers.py", "name": "MergedLinear", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
