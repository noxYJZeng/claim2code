      "claim_id": "deit_dev1",
      "text": "DeiT scales its base learning rate of 5e-4 linearly with the batch size as lr x batchsize / 512.",
      "evidence_span": {
        "section": "dev",
        "page": 1,
        "char_start": 0,
        "char_end": 96
      },
      "relevant_symbols": [
        {
          "file_path": "main.py",
          "name": "--lr",
          "kind": "config_schema"
        },
        {
          "file_path": "main.py",
          "name": "main",
          "kind": "function"
        }
      ],
      "expected_verification": "VERIFIED",
      "notes": "linear_scaled_lr = args.lr * args.batch_size * world_size / 512.0; default lr 5e-4."
    },
    {
      "claim_id": "deit_dev2",
      "text": "For soft distillation DeiT uses a temperature of 3 and a weight of 0.1 on the Kullback-Leibler term.",
      "evidence_span": {
        "section": "dev",
        "page": 1,
        "char_start": 0,
        "char_end": 100
      },
      "relevant_symbols": [
        {
          "file_path": "losses.py",
          "name": "forward",
          "kind": "function"
        },
        {
          "file_path": "main.py",
          "name": "--distillation-tau",
          "kind": "config_schema"
        },
        {
          "file_path": "main.py",
          "name": "--distillation-alpha",
          "kind": "config_schema"
        }
      ],
      "expected_verification": "PARTIALLY_VERIFIED",
      "notes": "Soft KL distillation with T*T scaling and alpha weighting is implemented, but defaults are tau=1.0, alpha=0.5."
    },
    {
      "claim_id": "deit_dev3",
      "text": "At test time DeiT adds the softmax outputs of the class and distillation classifiers to make its prediction.",
      "evidence_span": {
        "section": "dev",
        "page": 1,
        "char_start": 0,
        "char_end": 108
      },
      "relevant_symbols": [
        {
          "file_path": "models.py",
          "name": "forward",
          "kind": "function"
        }
      ],
      "expected_verification": "PARTIALLY_VERIFIED",
      "notes": "Both heads are combined at inference, but as the mean of logits ((x + x_dist) / 2), not a sum of softmax outputs."
    },
    {
      "claim_id": "deit_dev4",
      "text": "DeiT training uses label smoothing 0.1, Mixup 0.8, CutMix 1.0, random erasing 0.25 and stochastic depth 0.1.",
