  "claims": [
    {
      "claim_id": "aiayn_c1",
      "text": "The transformer computes scaled dot-product attention as softmax(QK^T / sqrt(d_k)) V.",
      "evidence_span": {"section": "3.2.1", "page": 4, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "attention", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c2",
      "text": "Multi-head attention linearly projects the queries, keys and values h times with different, learned linear projections.",
      "evidence_span": {"section": "3.2.2", "page": 4, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "MultiHeadedAttention", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c3",
      "text": "The positional encodings use sine and cosine functions of different frequencies.",
      "evidence_span": {"section": "3.5", "page": 6, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "PositionalEncoding", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c4",
      "text": "The position-wise feed-forward network consists of two linear transformations with a ReLU activation in between.",
      "evidence_span": {"section": "3.3", "page": 5, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "PositionwiseFeedForward", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c5",
      "text": "The encoder is composed of a stack of N = 6 identical layers, each with two sub-layers.",
      "evidence_span": {"section": "3.1", "page": 3, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "EncoderLayer", "kind": "class"},
        {"file_path": "the_annotated_transformer.py", "name": "Encoder", "kind": "class"},
        {"file_path": "the_annotated_transformer.py", "name": "make_model", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c6",
      "text": "The output of each sub-layer is LayerNorm(x + Sublayer(x)): a residual connection followed by layer normalization.",
      "evidence_span": {"section": "3.1", "page": 3, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "SublayerConnection", "kind": "class"}
      ],
      "expected_verification": "PARTIALLY_VERIFIED",
      "notes": "SublayerConnection computes x + dropout(sublayer(norm(x))) (pre-norm); its docstring notes the norm is applied first for code simplicity."
    },
    {
      "claim_id": "aiayn_c7",
      "text": "The decoder inserts a third sub-layer, which performs multi-head attention over the output of the encoder stack.",
      "evidence_span": {"section": "3.1", "page": 3, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "DecoderLayer", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c8",
      "text": "In the embedding layers, the weights are multiplied by sqrt(d_model).",
      "evidence_span": {"section": "3.4", "page": 5, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "Embeddings", "kind": "class"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c9",
      "text": "During training, label smoothing of value epsilon_ls = 0.1 is employed.",
      "evidence_span": {"section": "5.4", "page": 8, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "LabelSmoothing", "kind": "class"},
        {"file_path": "the_annotated_transformer.py", "name": "train_worker", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c10",
      "text": "The model is trained with the Adam optimizer with beta_1 = 0.9, beta_2 = 0.98 and epsilon = 1e-9.",
      "evidence_span": {"section": "5.3", "page": 7, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "train_worker", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c11",
      "text": "The learning rate increases linearly for the first warmup_steps training steps and decreases thereafter proportionally to the inverse square root of the step number.",
      "evidence_span": {"section": "5.3", "page": 7, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "the_annotated_transformer.py", "name": "rate", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "aiayn_c12",
      "text": "The base model uses h = 8 attention heads, d_model = 512, an inner feed-forward dimensionality d_ff = 2048 and dropout P_drop = 0.1.",
