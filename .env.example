# ============================================================
# Claim2Code — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claim2code
POSTGRES_USER=claim2code
POSTGRES_PASSWORD=change_me_local_dev
DATABASE_URL=postgresql+psycopg://claim2code:change_me_local_dev@localhost:5432/claim2code

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
# Optional read-only backend deployment; the static frontend demo needs no API.
API_READ_ONLY=false
# Model-management POSTs are disabled unless configured below.
# Set a private admin token securely, or explicitly allow actual loopback clients.
LLM_MANAGEMENT_TOKEN=
LLM_MANAGEMENT_ALLOW_LOCAL=false

# ---- Web (Vite) ----
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ---- LLM (provider abstraction) ----
# Either Azure OpenAI or any OpenAI-compatible endpoint.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CHAT=gpt-4o
OPENAI_MODEL_EMBED=text-embedding-3-small
OPENAI_EMBED_DIM=1536
# Per-call chat timeout (seconds). Raise for local models, e.g. 600.
LLM_REQUEST_TIMEOUT_SECONDS=60
#
# Local LM Studio alternative (OpenAI-compatible, http://localhost:1234):
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL_CHAT=qwen3.8-27b-mlx
# OPENAI_MODEL_EMBED=text-embedding-nomic-embed-text-v1.5
# OPENAI_EMBED_DIM=768
#
# Other chat providers, selectable in the web UI ("Chat model" panel).
# Embeddings always use the OPENAI_* block above. Keys are optional;
# fill in only the providers you want to use.
ANTHROPIC_API_KEY=
OPENAI_PLATFORM_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---- Phase 7: Related Work (literature search) ----
# Optional. With a key, Semantic Scholar raises from ~1 req/s
# (anonymous) to 100 req/5 min via the ``x-api-key`` header.
# Get a key at https://www.semanticscholar.org/product/api.
# When unset, the API runs in anonymous mode (still works).
SEMANTIC_SCHOLAR_API_KEY=

# ---- GitHub ----
# Optional. Public repos work without auth (rate-limited); set a token
# for higher rate limits when ingesting popular repos.
GITHUB_TOKEN=

# ---- Safety ----
# Hard limits that gate ingestion. Repo larger than MAX_REPO_MB_MEGS is
# rejected. Repo with more than MAX_REPO_FILES files is rejected.
MAX_REPO_MB_MEGS=200
MAX_REPO_FILES=20000
MAX_FILE_KB=512

# ---- Observability ----
OTEL_SERVICE_NAME=claim2code
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_CONSOLE=true

# ---- Workflow timeouts (seconds) ----
WORKFLOW_TIMEOUT_PAPER=180
WORKFLOW_TIMEOUT_REPO=300
WORKFLOW_TIMEOUT_TOTAL=900
