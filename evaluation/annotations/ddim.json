      "expected_verification": "VERIFIED",
      "notes": "num_diffusion_timesteps: 1000; noise_estimation_loss is the unweighted (gamma=1) epsilon loss."
    },
    {
      "claim_id": "ddim_c5",
      "text": "Simple interpolations in xT can lead to semantically meaningful interpolations between two samples.",
      "evidence_span": {"section": "5.3", "page": 8, "char_start": 0, "char_end": 100},
