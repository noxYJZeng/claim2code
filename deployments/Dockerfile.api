# ============================================================
# Claim2Code — API Dockerfile
# Build context must be the project root.
# ============================================================
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps (git for cloning target repos in Phase 3; curl for healthchecks)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install the package. We do a single COPY of apps/api so that
# pyproject.toml + the source tree stay in sync; editable install is not
# needed at runtime.
COPY apps/api /app/api
RUN pip install --upgrade pip \
    && pip install /app/api

ENV PYTHONPATH=/app

EXPOSE 8000
# The app factory lives in claim2code_api.app.main — referenced by the
# CMD below. Pinned to the module string for visibility in `docker ps`.
CMD ["uvicorn", "claim2code_api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
