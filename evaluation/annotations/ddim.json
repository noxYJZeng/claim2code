  "claims": [
    {
      "claim_id": "ddim_c1",
      "text": "DDIMs generalize DDPMs via a class of non-Markovian diffusion processes that lead to the same training objective.",
      "evidence_span": {"section": "1", "page": 2, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "functions/denoising.py", "name": "generalized_steps", "kind": "function"},
        {"file_path": "functions/losses.py", "name": "noise_estimation_loss", "kind": "function"}
      ],
      "expected_verification": "VERIFIED",
      "notes": "Sampler and shared loss are code; the non-Markovian derivation is theory. Relabelled 2026-10-27 from PARTIALLY_VERIFIED: no paper/code mismatch, and PARTIALLY_VERIFIED requires one (phase-6-design.md §2.5)."
    },
    {
      "claim_id": "ddim_c2",
      "text": "The resulting model with σt = 0 for all t becomes an implicit probabilistic model, named the denoising diffusion implicit model (DDIM).",
      "evidence_span": {"section": "4.1", "page": 5, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "functions/denoising.py", "name": "generalized_steps", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "ddim_c3",
      "text": "DDIMs allow for a trade-off between computation and sample quality by sampling on a sub-sequence of timesteps.",
      "evidence_span": {"section": "4.2", "page": 5, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "runners/diffusion.py", "name": "sample_image", "kind": "method"},
        {"file_path": "functions/denoising.py", "name": "generalized_steps", "kind": "function"}
      ],
      "expected_verification": "VERIFIED"
    },
    {
      "claim_id": "ddim_c4",
      "text": "For each dataset, the same trained model with T = 1000 and the objective being Lγ from Eq. (5) with γ = 1 is used.",
      "evidence_span": {"section": "5", "page": 6, "char_start": 0, "char_end": 100},
      "relevant_symbols": [
        {"file_path": "configs/cifar10.yml", "name": "configs/cifar10.yml", "kind": "config_schema"},
        {"file_path": "configs/celeba.yml", "name": "configs/celeba.yml", "kind": "config_schema"},
